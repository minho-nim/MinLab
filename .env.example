# MinLab 기록은 Codex에서 작성한 .minlab/records.json을 사용합니다.
# 별도 AI API 키나 환경 변수 설정은 필요하지 않습니다.

# Optional: Supabase remote publishing. These two values are public browser config.
# Never place a service_role key, secret key, password or database URL in VITE_*.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
