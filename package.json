{
  "name": "minlab-project-archive",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "records:sync": "node scripts/sync-records.mjs",
    "predev": "npm run records:sync",
    "prebuild": "npm run records:sync",
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build && vite build --config vite.schedule.config.ts",
    "preview": "vite preview",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc --noEmit",
    "test:links": "tsx --test src/utils/projectLinkMigration.test.ts",
    "test": "node --import tsx --test src/data/*.test.ts src/utils/*.test.ts",
    "test:browser": "node scripts/test-portfolio.cjs",
    "test:loading": "node scripts/test-deferred-editors.cjs",
    "test:media": "node scripts/test-media-experience.cjs",
    "test:motion": "node scripts/test-motion.cjs",
    "test:chapters": "node scripts/test-chapters.cjs",
    "test:capabilities": "node scripts/test-capability-links.cjs",
    "test:remote": "node scripts/test-remote-studio.cjs",
    "test:schedule": "node --import tsx --test apps/work-schedule/src/utils/*.test.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jszip": "^3.10.2",
    "lucide-react": "^0.546.0",
    "mammoth": "^1.13.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@xmldom/xmldom": "^0.8.15",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "playwright": "^1.58.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
